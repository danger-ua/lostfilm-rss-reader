# LostFilm.tv Credentials
# Get these from your browser cookies after logging into LostFilm.tv
# Look for 'uid' and 'usess' cookies
LOSTFILM_UID=your_user_id_here
LOSTFILM_USESS=your_session_token_here

# Storage & Scheduler
DB_PATH=lostfilm.db
CHECK_INTERVAL_SECONDS=3600

# Telegram Notifications
# Token for your Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
# ID of the user or channel to send notifications to
TELEGRAM_CHAT_ID=your_chat_id_here
